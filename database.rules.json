{
  "rules": {
    "sessions": {
      "$sessionId": {
        ".read": true,
        ".write": true,
        "status": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "currentQuestion": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "currentQuestionIndex": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "players": {
          "$playerId": {
            ".write": "!data.exists() || $playerId === auth.uid || data.parent().parent().child('hostId').val() === auth.uid"
          }
        },
        "responses": {
          "$questionId": {
            "$playerId": {
              ".write": "$playerId === auth.uid && !data.exists()",
              ".validate": "newData.hasChildren(['optionId', 'timestamp'])"
            }
          }
        }
      }
    },
    "raffles": {
      ".indexOn": ["hostId"],
      ".read": "auth != null && query.orderByChild === 'hostId' && query.equalTo === auth.uid",
      "$raffleId": {
        ".read": true,
        ".write": true,
        "participants": {
          "$participantId": {
            ".write": true,
            ".validate": "newData.hasChildren(['id', 'name', 'joinedAt'])"
          }
        }
      }
    }
  }
}
