{
  "rules": {
    "sessions": {
      "$sessionId": {
        ".read": true,
        ".write": "auth != null && (data.child('hostId').val() === auth.uid || newData.child('hostId').val() === auth.uid)",
        "players": {
          "$playerId": {
            ".write": "newData.exists()",
            ".validate": "newData.hasChildren(['id', 'nickname'])"
          }
        },
        "responses": {
          "$questionId": {
            "$playerId": {
              ".write": "!data.exists() && newData.exists()",
              ".validate": "newData.hasChildren(['optionId', 'timestamp'])"
            }
          }
        }
      }
    },
    "raffles": {
      ".indexOn": ["hostId"],
      ".read": "auth != null && query.orderByChild === 'hostId' && query.equalTo === auth.uid",
      "$raffleId": {
        ".read": true,
        ".write": "auth != null && (data.child('hostId').val() === auth.uid || newData.child('hostId').val() === auth.uid)",
        "participants": {
          "$participantId": {
            ".write": "!data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['id', 'name', 'joinedAt'])"
          }
        }
      }
    }
  }
}
