---
import Layout from '../../../layouts/Layout.astro';
import HostLivePage from '../../../islands/HostLivePage';
import { getLang } from '../../../i18n';

const { id } = Astro.params;
const lang = getLang(Astro);

export function getStaticPaths() {
  return [{ params: { id: 'demo' } }];
}
---

<Layout title="ControlDeck - QuizTown">
  <HostLivePage sessionId={id ?? 'demo'} lang={lang} client:load />
</Layout>

<style>
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
